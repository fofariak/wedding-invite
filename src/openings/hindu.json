    { "id": "hi-vis-lakshmi-narayan", "sub": "vishnu", "title": "Shri Lakshmi-Narayanaya Namah", "type": "phrase", "script": "deva", "lang": "sa", "text": "॥ श्री लक्ष्मी-नारायणाय नमः ॥", "gujarati": true },
