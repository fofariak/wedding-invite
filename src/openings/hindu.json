    { "id": "hi-shi-parvati-parameshwar", "sub": "shiva", "title": "Shri Parvatiparameshwarabhyam Namah", "type": "phrase", "script": "deva", "lang": "sa", "text": "॥ श्री पार्वतीपरमेश्वराभ्यां नमः ॥", "gujarati": true },
    { "id": "hi-shi-har-har", "sub": "shiva", "title": "Har Har Mahadev", "type": "phrase", "script": "deva", "lang": "hi", "text": "॥ हर हर महादेव ॥", "gujarati": true },
    { "id": "hi-shi-shivaya", "sub": "shiva", "title": "Shri Shivaya Namah", "type": "phrase", "script": "deva", "lang": "sa", "text": "॥ श्री शिवाय नमः ॥", "gujarati": true },
    { "id": "hi-shi-karpur-gauram", "sub": "shiva", "title": "Karpur Gauram", "type": "shloka", "script": "deva", "lang": "sa", "text": "कर्पूरगौरं करुणावतारं\nसंसारसारं भुजगेन्द्रहारम्।\nसदा वसन्तं हृदयारविन्दे\nभवं भवानीसहितं नमामि॥", "gujarati": true },
    { "id": "hi-shi-uma-maheshwar", "sub": "shiva", "title": "Uma Maheshwar", "type": "shloka", "script": "deva", "lang": "sa", "text": "नमः शिवाभ्यां नवयौवनाभ्याम्\nपरस्पराश्लिष्टवपुर्धराभ्याम्।\nनगेन्द्रकन्यावृषकेतनाभ्यां\nनमो नमः शङ्करपार्वतीभ्याम्॥", "corrected": "Third line: supplied text read 'वृषकेतनोभ्यां'; changed to 'वृषकेतनाभ्यां' (dual form, matching the other lines).", "gujarati": true },

