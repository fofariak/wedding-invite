    { "id": "hi-vis-shriman-narayan", "sub": "vishnu", "title": "Shriman Narayanaya Namah", "type": "phrase", "script": "deva", "lang": "sa", "text": "॥ श्रीमन्नारायणाय नमः ॥", "corrected": "Supplied text read 'श्रीमन नारायणाय'; changed to the joined form 'श्रीमन्नारायणाय'.", "gujarati": true },
    { "id": "hi-vis-mangalam-shloka", "sub": "vishnu", "title": "Mangalam Bhagavan Vishnuh", "type": "shloka", "script": "deva", "lang": "sa", "text": "मङ्गलं भगवान् विष्णुः मङ्गलं गरुडध्वजः।\nमङ्गलं पुण्डरीकाक्षः मङ्गलायतनो हरिः॥", "gujarati": true },
    { "id": "hi-vis-krishnaya-shloka", "sub": "vishnu", "title": "Krishna Shloka", "type": "shloka", "script": "deva", "lang": "sa", "text": "कृष्णाय वासुदेवाय हरये परमात्मने।\nप्रणतः क्लेशनाशाय गोविन्दाय नमो नमः॥", "gujarati": true },
    { "id": "hi-vis-lakshmikantam", "sub": "vishnu", "title": "Lakshmi Narayan Shloka", "type": "shloka", "script": "deva", "lang": "sa", "text": "लक्ष्मीकान्तं कमलनयनं योगिभिर्ध्यानगम्यम्।\nवन्दे विष्णुं भवभयहरं सर्वलोकैकनाथम्॥", "gujarati": true },

    { "id": "hi-dev-mahalakshmi", "sub": "devi", "title": "Shri Mahalakshmyai Namah", "type": "phrase", "script": "deva", "lang": "sa", "text": "॥ श्री महालक्ष्म्यै नमः ॥", "gujarati": true },
    { "id": "hi-dev-om-shrim", "sub": "devi", "title": "Mahalakshmi Mantra", "type": "mantra", "script": "deva", "lang": "sa", "text": "॥ ॐ श्रीं महालक्ष्म्यै नमः ॥", "gujarati": true },
    { "id": "hi-dev-jai-mata-di", "sub": "devi", "title": "Jai Mata Di", "type": "phrase", "script": "deva", "lang": "hi", "text": "॥ जय माता दी ॥", "gujarati": true },
    { "id": "hi-dev-durgayai", "sub": "devi", "title": "Shri Durgayai Namah", "type": "phrase", "script": "deva", "lang": "sa", "text": "॥ श्री दुर्गायै नमः ॥", "gujarati": true },
    { "id": "hi-dev-ambikayai", "sub": "devi", "title": "Shri Ambikayai Namah", "type": "phrase", "script": "deva", "lang": "sa", "text": "॥ श्री अम्बिकायै नमः ॥", "gujarati": true },
    { "id": "hi-dev-jai-ambe", "sub": "devi", "title": "Jai Ambe Gauri", "type": "phrase", "script": "deva", "lang": "hi", "text": "॥ जय अम्बे गौरी ॥", "gujarati": true },
    { "id": "hi-dev-sarvamangala-short", "sub": "devi", "title": "Sarvamangala Mangalye Namah", "type": "phrase", "script": "deva", "lang": "sa", "text": "॥ सर्वमङ्गलमाङ्गल्ये नमः ॥", "gujarati": true },
    { "id": "hi-dev-sarvamangala", "sub": "devi", "title": "Sarva Mangala Mangalye", "type": "shloka", "script": "deva", "lang": "sa", "text": "सर्वमङ्गलमाङ्गल्ये शिवे सर्वार्थसाधिके।\nशरण्ये त्र्यम्बके गौरि नारायणि नमोऽस्तुते॥", "gujarati": true },
    { "id": "hi-dev-namaste-mahamaye", "sub": "devi", "title": "Lakshmi Shloka", "type": "shloka", "script": "deva", "lang": "sa", "text": "नमस्तेऽस्तु महामाये श्रीपीठे सुरपूजिते।\nशङ्खचक्रगदाहस्ते महालक्ष्मि नमोऽस्तुते॥", "gujarati": true },

    { "id": "hi-sar-ya-kundendu", "sub": "saraswati", "title": "Ya Kundendu Tusharahara Dhavala", "type": "shloka", "script": "deva", "lang": "sa", "text": "या कुन्देन्दुतुषारहारधवला या शुभ्रवस्त्रावृता।\nया वीणावरदण्डमण्डितकरा या श्वेतपद्मासना॥\nया ब्रह्माच्युतशङ्करप्रभृतिभिर्देवैः सदा वन्दिता।\nसा मां पातु सरस्वती भगवती निःशेषजाड्यापहा॥", "gujarati": true },

    { "id": "hi-swa-jai-swaminarayan", "sub": "swaminarayan", "title": "Jai Swaminarayan", "type": "phrase", "script": "deva", "lang": "hi", "text": "॥ जय स्वामिनारायण ॥", "gujarati": true },
    { "id": "hi-swa-vijayatetaram", "sub": "swaminarayan", "title": "Shri Swaminarayano Vijayatetaram", "type": "phrase", "script": "deva", "lang": "sa", "text": "॥ श्री स्वामिनारायणो विजयतेतराम् ॥", "gujarati": true },
    { "id": "hi-swa-sahajanand", "sub": "swaminarayan", "title": "Shri Sahajanand Swami Maharajaya Namah", "type": "phrase", "script": "deva", "lang": "sa", "text": "॥ श्री सहजानन्द स्वामी महाराजाय नमः ॥", "gujarati": true },
    { "id": "hi-swa-ghanshyam", "sub": "swaminarayan", "title": "Shri Ghanshyamaya Namah", "type": "phrase", "script": "deva", "lang": "sa", "text": "॥ श्री घनश्यामाय नमः ॥", "gujarati": true },
    { "id": "hi-swa-bhagwan-ki-jai", "sub": "swaminarayan", "title": "Swaminarayan Bhagwan ki Jai", "type": "phrase", "script": "deva", "lang": "hi", "text": "॥ स्वामिनारायण भगवान की जय ॥", "gujarati": true },

    { "id": "hi-ved-om", "sub": "vedic", "title": "Om", "type": "mantra", "script": "deva", "lang": "sa", "text": "ॐ", "gujarati": true },
    { "id": "hi-ved-om-tatsat", "sub": "vedic", "title": "Om Tat Sat", "type": "mantra", "script": "deva", "lang": "sa", "text": "॥ ॐ तत्सत् ॥", "gujarati": true },
    { "id": "hi-ved-om-shubhamastu", "sub": "vedic", "title": "Om Shubhamastu", "type": "phrase", "script": "deva", "lang": "sa", "text": "॥ ॐ शुभमस्तु ॥", "gujarati": true },
    { "id": "hi-ved-krinvanto", "sub": "vedic", "title": "Krinvanto Vishvamaryam", "type": "phrase", "script": "deva", "lang": "sa", "text": "॥ कृण्वन्तो विश्वमार्यम् ॥", "gujarati": true },
    { "id": "hi-ved-sarve-bhavantu-short", "sub": "vedic", "title": "Sarve Bhavantu Sukhinah", "type": "phrase", "script": "deva", "lang": "sa", "text": "॥ सर्वे भवन्तु सुखिनः ॥", "gujarati": true },

    { "id": "hi-bls-sarve-bhavantu", "sub": "blessings", "title": "Sarve Bhavantu Sukhinah", "type": "shloka", "script": "deva", "lang": "sa", "text": "सर्वे भवन्तु सुखिनः सर्वे सन्तु निरामयाः।\nसर्वे भद्राणि पश्यन्तु मा कश्चिद्दुःखभाग्भवेत्॥", "gujarati": true },
    { "id": "hi-bls-swasti", "sub": "blessings", "title": "Swasti Mantra", "type": "shloka", "script": "deva", "lang": "sa", "text": "स्वस्ति प्रजाभ्यः परिपालयन्तां\nन्यायेन मार्गेण महीं महीशाः।\nगोब्राह्मणेभ्यः शुभमस्तु नित्यं\nलोकाः समस्ताः सुखिनो भवन्तु॥", "gujarati": true },
    { "id": "hi-bls-shubham-karoti", "sub": "blessings", "title": "Shubham Karoti Kalyanam", "type": "shloka", "script": "deva", "lang": "sa", "text": "शुभं करोति कल्याणम् आरोग्यं धनसम्पदा।\nशत्रुबुद्धिविनाशाय दीपज्योतिर्नमोऽस्तुते॥", "gujarati": true },
    { "id": "hi-bls-ihaiva-stam", "sub": "blessings", "title": "Vedic Wedding Blessing (Ihaiva Stam)", "type": "mantra", "script": "deva", "lang": "sa", "text": "इहैव स्तं मा वि यौष्टं\nविश्वमायुर्व्यश्नुतम्।\nक्रीळन्तौ पुत्रैर्नप्तृभिर्मोदमानौ\nस्वे गृहे॥", "ref": "Rigveda 10.85.42", "gujarati": true },
    { "id": "hi-bls-samrajni", "sub": "blessings", "title": "Vedic Wedding Blessing (Samrajni)", "type": "mantra", "script": "deva", "lang": "sa", "text": "सम्राज्ञी श्वशुरे भव सम्राज्ञी श्वश्र्वां भव।\nननान्दरि सम्राज्ञी भव सम्राज्ञी अधि देवृषु॥", "ref": "Rigveda 10.85.46", "gujarati": true }
  ]
}
