    { "id": "hi-gan-bappa-morya", "sub": "ganesh", "title": "Ganpati Bappa Morya", "type": "phrase", "script": "deva", "lang": "mr", "text": "॥ गणपति बप्पा मोरया ॥", "gujarati": true },
    { "id": "hi-gan-vakratunda", "sub": "ganesh", "title": "Vakratunda Mahakaya", "type": "shloka", "script": "deva", "lang": "sa", "text": "वक्रतुण्ड महाकाय सूर्यकोटि समप्रभ।\nनिर्विघ्नं कुरु मे देव सर्वकार्येषु सर्वदा॥", "gujarati": true },
    { "id": "hi-gan-shuklambaradharam", "sub": "ganesh", "title": "Shuklambaradharam", "type": "shloka", "script": "deva", "lang": "sa", "text": "शुक्लाम्बरधरं विष्णुं शशिवर्णं चतुर्भुजम्।\nप्रसन्नवदनं ध्यायेत् सर्वविघ्नोपशान्तये॥", "gujarati": true },
    { "id": "hi-gan-gajananam", "sub": "ganesh", "title": "Gajananam", "type": "shloka", "script": "deva", "lang": "sa", "text": "गजाननं भूतगणादिसेवितं\nकपित्थजम्बूफलचारुभक्षणम्।\nउमासुतं शोकविनाशकारकं\nनमामि विघ्नेश्वरपादपङ्कजम्॥", "gujarati": true },
    { "id": "hi-gan-gananam-tva", "sub": "ganesh", "title": "Ganapati Vedic Mantra", "type": "mantra", "script": "deva", "lang": "sa", "text": "ॐ गणानां त्वा गणपतिं हवामहे\nकविं कवीनामुपमश्रवस्तमम्।\nज्येष्ठराजं ब्रह्मणां ब्रह्मणस्पत\nआ नः शृण्वन्नूतिभिः सीद सादनम्॥", "ref": "Rigveda 2.23.1", "gujarati": true },

    { "id": "hi-shi-om-namah-shivaya", "sub": "shiva", "title": "Om Namah Shivaya", "type": "mantra", "script": "deva", "lang": "sa", "text": "॥ ॐ नमः शिवाय ॥", "gujarati": true },
    { "id": "hi-shi-umamaheshwar", "sub": "shiva", "title": "Shri Umamaheshwarabhyam Namah", "type": "phrase", "script": "deva", "lang": "sa", "text": "॥ श्री उमामहेश्वराभ्यां नमः ॥", "gujarati": true },
